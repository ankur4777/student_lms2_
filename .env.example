# Django
DJANGO_SECRET_KEY=replace-with-a-secure-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-backend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-backend.vercel.app

# Database
# Local MySQL: django.db.backends.mysql
# TiDB Cloud: django_tidb
DB_ENGINE=django_tidb
DB_NAME=student_lms
DB_USER=replace-with-tidb-username
DB_PASSWORD=replace-with-secure-password
DB_HOST=replace-with-tidb-host
DB_PORT=4000

# TiDB Starter works securely with mysqlclient's default SSL mode.
# Set DB_CA_PATH only if you choose explicit certificate verification.
# DB_CA_PATH=/etc/ssl/certs/ca-certificates.crt

# Optional persistent media paths when using a Render disk
# MEDIA_ROOT=/var/data/media
# PRIVATE_MEDIA_ROOT=/var/data/private_media

# Currency
CURRENCY_TRUST_PROXY_HEADERS=true
