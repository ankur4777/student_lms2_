# Django
DJANGO_SECRET_KEY=replace-with-a-secure-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com

# MySQL
DB_NAME=student_lms
DB_USER=lms_user
DB_PASSWORD=replace-with-a-secure-password
DB_HOST=your-mysql-service
DB_PORT=3306

# Optional persistent media paths when using a Render disk
# MEDIA_ROOT=/var/data/media
# PRIVATE_MEDIA_ROOT=/var/data/private_media

# Currency
CURRENCY_TRUST_PROXY_HEADERS=true
